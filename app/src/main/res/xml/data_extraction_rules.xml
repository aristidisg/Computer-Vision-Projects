<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup to Google Drive and device-to-device transfer (API 31+). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <exclude domain="file" path="import-staging/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <exclude domain="file" path="import-staging/" />
    </device-transfer>
</data-extraction-rules>
